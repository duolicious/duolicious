    "@playwright/test": "^1.60.0",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.6",
    "@types/node": "^20.14.11",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "patch-package": "^6.5.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": ["expo-image"]
      }
    }
  },
  "private": true
